{
  "openapi": "3.1.0",
  "info": {
    "title": "ECOAGENT Cloud API",
    "version": "0.9.0",
    "description": "Private single-operator preview. Set deployed HTTPS server before importing. No automatic writes."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service health"
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "operationId": "createJob",
        "description": "Submit a bounded batch. Only anonymous public read tasks can run automatically if enabled; all other jobs wait for operator.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "steps"
                ],
                "properties": {
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "required": [
                        "op"
                      ],
                      "properties": {
                        "op": {
                          "type": "string",
                          "enum": [
                            "open",
                            "read",
                            "inspect",
                            "find",
                            "fill",
                            "click",
                            "close"
                          ]
                        },
                        "url": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "fill",
                            "click"
                          ]
                        },
                        "value": {
                          "type": "string"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "snapshot": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job accepted"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status and authorized results"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "clientBearer": []
    }
  ]
}